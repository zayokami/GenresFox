{
    "manifest_version": 3,
    "name": "GenresFox",
    "version": "0.4.8.0",
    "description": "A completely open-source, high-performance, and extremely minimalist browser new tab page extension.",
    "default_locale": "en",
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "permissions": [],
    "host_permissions": [
        "https://www.bing.com/*",
        "https://bing.biturl.top/*"
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "icons": {
        "128": "icon.png"
    },
    "license": "MIT"
}
